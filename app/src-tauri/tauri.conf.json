{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adbcp",
  "version": "0.2.0",
  "identifier": "dev.adbcp.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "adbcp",
        "width": 820,
        "height": 760,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../adbcp": "engine/adbcp",
      "../../platform-tools/adb": "engine/platform-tools/adb",
      "../../platform-tools/NOTICE.txt": "engine/platform-tools/NOTICE.txt"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
